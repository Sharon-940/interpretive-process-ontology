###  http://www.semanticweb.org/int_r1/c2935f91-bd85-44cf-8116-43a3df1a3baf
:c2935f91-bd85-44cf-8116-43a3df1a3baf rdf:type owl:NamedIndividual ,
                                               :InterpretiveObservation ;
                                      :wasProducedBy <http://www.semanticweb.org/int_r1/5e066aac-571a-4023-b163-7649f63805b3> ;
                                      <http://www.w3.org/ns/prov#wasInfluencedBy> <http://www.semanticweb.org/int_r1/762cc2cf-1a22-4658-95b8-fbaa3b31dd9a> ;
                                      rdfs:comment "These frescoes are noteworthy"@en ;
