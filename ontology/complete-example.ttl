                                                                         <http://www.w3.org/ns/prov#wasDerivedFrom> <http://www.semanticweb.org/int_r1/66310e30-0c27-4e6f-8af6-50259a651dcb> ,
                                                                                                                    :fd3c40b1-0c49-4a67-8925-c4243c8df5cd ;
